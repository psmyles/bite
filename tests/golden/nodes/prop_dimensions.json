{
  "definition": {
    "id": "prop_dimensions",
    "version": "1.0.0",
    "label": "Dimensions",
    "description": "Outputs the width and height of the current image in pixels",
    "category": "Properties",
    "inputs": [],
    "outputs": [],
    "executor": "prop_dimensions",
    "needs_image_meta": true,
    "params": [
      {
        "name": "width",
        "label": "Width",
        "type": "int",
        "widget": "number",
        "default": 0,
        "readonly": true
      },
      {
        "name": "height",
        "label": "Height",
        "type": "int",
        "widget": "number",
        "default": 0,
        "readonly": true
      }
    ]
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "width": 0,
        "height": 0
      },
      "meta": {
        "path": "/fixtures/photo.test.png",
        "name": "photo.test.png",
        "sizeBytes": 4096,
        "width": 128,
        "height": 75,
        "bitDepth": 16,
        "extension": "png",
        "dpiX": 300,
        "dpiY": 72,
        "exif": {
          "Make": "TestCam",
          "FNumber": "28/10",
          "FocalLength": "50/1",
          "ISOSpeedRatings": "200,0",
          "DateTimeOriginal": "2020:01:02 03:04:05"
        }
      },
      "expected_params": {
        "width": 128,
        "height": 75
      }
    },
    {
      "name": "defaults-no-meta",
      "params": {
        "width": 0,
        "height": 0
      },
      "expected_params": {
        "width": 0,
        "height": 0
      }
    },
    {
      "name": "missing",
      "params": {},
      "meta": {
        "path": "/fixtures/photo.test.png",
        "name": "photo.test.png",
        "sizeBytes": 4096,
        "width": 128,
        "height": 75,
        "bitDepth": 16,
        "extension": "png",
        "dpiX": 300,
        "dpiY": 72,
        "exif": {
          "Make": "TestCam",
          "FNumber": "28/10",
          "FocalLength": "50/1",
          "ISOSpeedRatings": "200,0",
          "DateTimeOriginal": "2020:01:02 03:04:05"
        }
      },
      "expected_params": {
        "width": 128,
        "height": 75
      }
    },
    {
      "name": "missing-no-meta",
      "params": {},
      "expected_params": {
        "width": 0,
        "height": 0
      }
    }
  ]
}
