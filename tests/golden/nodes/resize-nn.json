{
  "definition": {
    "id": "resize-nn",
    "version": "1.0.0",
    "label": "Resize (Nearest Neighbor)",
    "description": "Resize with nearest-neighbor (Point) filter - no interpolation or blurring, ideal for pixel art",
    "category": "Transform",
    "inputs": [
      {
        "type": "image",
        "label": "Input"
      }
    ],
    "outputs": [
      {
        "type": "image",
        "label": "Output"
      }
    ],
    "params": [
      {
        "name": "width",
        "label": "Width",
        "type": "int",
        "widget": "number",
        "default": 64,
        "min": 1,
        "max": 16384
      },
      {
        "name": "height",
        "label": "Height",
        "type": "int",
        "widget": "number",
        "default": 64,
        "min": 1,
        "max": 16384
      },
      {
        "name": "ignore_aspect",
        "label": "Ignore Aspect Ratio",
        "type": "bool",
        "widget": "checkbox",
        "default": true
      }
    ],
    "command_js": "const flag = params.ignore_aspect ? '!' : ''\nreturn ['-filter', 'Point', '-resize', params.width + 'x' + params.height + flag]"
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "width": 64,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x64!"
      ]
    },
    {
      "name": "missing",
      "params": {},
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "undefinedxundefined"
      ]
    },
    {
      "name": "width-0",
      "params": {
        "width": 0,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "0x64!"
      ]
    },
    {
      "name": "width-1",
      "params": {
        "width": -1,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "-1x64!"
      ]
    },
    {
      "name": "width-2",
      "params": {
        "width": 0.5,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "0.5x64!"
      ]
    },
    {
      "name": "width-3",
      "params": {
        "width": 1,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "1x64!"
      ]
    },
    {
      "name": "width-4",
      "params": {
        "width": 16384,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "16384x64!"
      ]
    },
    {
      "name": "height-0",
      "params": {
        "width": 64,
        "height": 0,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x0!"
      ]
    },
    {
      "name": "height-1",
      "params": {
        "width": 64,
        "height": -1,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x-1!"
      ]
    },
    {
      "name": "height-2",
      "params": {
        "width": 64,
        "height": 0.5,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x0.5!"
      ]
    },
    {
      "name": "height-3",
      "params": {
        "width": 64,
        "height": 1,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x1!"
      ]
    },
    {
      "name": "height-4",
      "params": {
        "width": 64,
        "height": 16384,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x16384!"
      ]
    },
    {
      "name": "ignore_aspect-0",
      "params": {
        "width": 64,
        "height": 64,
        "ignore_aspect": false
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x64"
      ]
    },
    {
      "name": "ignore_aspect-1",
      "params": {
        "width": 64,
        "height": 64,
        "ignore_aspect": true
      },
      "expected_args": [
        "-filter",
        "Point",
        "-resize",
        "64x64!"
      ]
    }
  ]
}
