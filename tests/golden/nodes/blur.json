{
  "definition": {
    "id": "blur",
    "version": "1.0.0",
    "label": "Blur",
    "description": "Apply Gaussian blur",
    "aliases": [
      "soften",
      "gaussian blur",
      "smooth"
    ],
    "category": "Filters",
    "icon": "droplets",
    "inputs": [
      {
        "type": "image",
        "label": "Input"
      }
    ],
    "outputs": [
      {
        "type": "image",
        "label": "Output"
      }
    ],
    "params": [
      {
        "name": "sigma",
        "label": "Sigma",
        "type": "float",
        "widget": "slider",
        "default": 2,
        "min": 0.1,
        "max": 50,
        "step": 0.1
      }
    ],
    "command_template": "-blur 0x{{sigma}}"
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "sigma": 2
      },
      "expected_args": [
        "-blur",
        "0x2"
      ]
    },
    {
      "name": "missing",
      "params": {},
      "expected_args": [
        "-blur",
        "0x2"
      ]
    },
    {
      "name": "sigma-0",
      "params": {
        "sigma": 0
      },
      "expected_args": [
        "-blur",
        "0x0"
      ]
    },
    {
      "name": "sigma-1",
      "params": {
        "sigma": -1
      },
      "expected_args": [
        "-blur",
        "0x-1"
      ]
    },
    {
      "name": "sigma-2",
      "params": {
        "sigma": 0.5
      },
      "expected_args": [
        "-blur",
        "0x0.5"
      ]
    },
    {
      "name": "sigma-3",
      "params": {
        "sigma": 0.1
      },
      "expected_args": [
        "-blur",
        "0x0.1"
      ]
    },
    {
      "name": "sigma-4",
      "params": {
        "sigma": 50
      },
      "expected_args": [
        "-blur",
        "0x50"
      ]
    }
  ]
}
