{
  "definition": {
    "id": "crop",
    "version": "1.0.0",
    "label": "Crop",
    "description": "Crop a rectangular region from the image",
    "aliases": [
      "cut",
      "slice",
      "region"
    ],
    "category": "Transform",
    "icon": "crop",
    "inputs": [
      {
        "type": "image",
        "label": "Input"
      }
    ],
    "outputs": [
      {
        "type": "image",
        "label": "Output"
      }
    ],
    "params": [
      {
        "name": "width",
        "label": "Width",
        "type": "int",
        "widget": "slider",
        "default": 1024,
        "min": 1,
        "max": 16384
      },
      {
        "name": "height",
        "label": "Height",
        "type": "int",
        "widget": "slider",
        "default": 1024,
        "min": 1,
        "max": 16384
      },
      {
        "name": "x",
        "label": "X Offset",
        "type": "int",
        "widget": "slider",
        "default": 0,
        "min": 0,
        "max": 16384
      },
      {
        "name": "y",
        "label": "Y Offset",
        "type": "int",
        "widget": "slider",
        "default": 0,
        "min": 0,
        "max": 16384
      }
    ],
    "command_template": "-crop {{width}}x{{height}}+{{x}}+{{y}} +repage"
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "width": 1024,
        "height": 1024,
        "x": 0,
        "y": 0
      },
      "expected_args": [
        "-crop",
        "1024x1024+0+0",
        "+repage"
      ]
    },
    {
      "name": "missing",
      "params": {},
      "expected_args": [
        "-crop",
        "1024x1024+0+0",
        "+repage"
      ]
    },
    {
      "name": "width-0",
      "params": {
        "width": 0,
        "height": 1024,
        "x": 0,
        "y": 0
      },
      "expected_args": [
        "-crop",
        "0x1024+0+0",
        "+repage"
      ]
    },
    {
      "name": "width-1",
      "params": {
        "width": -1,
        "height": 1024,
        "x": 0,
        "y": 0
      },
      "expected_args": [
