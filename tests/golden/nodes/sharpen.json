{
  "definition": {
    "id": "sharpen",
    "version": "1.0.0",
    "label": "Sharpen",
    "description": "Apply unsharp mask sharpening",
    "aliases": [
      "unsharp mask",
      "crisp",
      "detail"
    ],
    "category": "Filters",
    "icon": "zap",
    "inputs": [
      {
        "type": "image",
        "label": "Input"
      }
    ],
    "outputs": [
      {
        "type": "image",
        "label": "Output"
      }
    ],
    "params": [
      {
        "name": "sigma",
        "label": "Radius",
        "type": "float",
        "widget": "slider",
        "default": 1,
        "min": 0.1,
        "max": 10,
        "step": 0.1
      },
      {
        "name": "amount",
        "label": "Amount",
        "type": "float",
        "widget": "slider",
        "default": 1,
        "min": 0,
        "max": 5,
        "step": 0.1
      }
    ],
    "command_template": "-unsharp 0x{{sigma}}+{{amount}}"
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "sigma": 1,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x1+1"
      ]
    },
    {
      "name": "missing",
      "params": {},
      "expected_args": [
        "-unsharp",
        "0x1+1"
      ]
    },
    {
      "name": "sigma-0",
      "params": {
        "sigma": 0,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x0+1"
      ]
    },
    {
      "name": "sigma-1",
      "params": {
        "sigma": -1,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x-1+1"
      ]
    },
    {
      "name": "sigma-2",
      "params": {
        "sigma": 0.5,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x0.5+1"
      ]
    },
    {
      "name": "sigma-3",
      "params": {
        "sigma": 0.1,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x0.1+1"
      ]
    },
    {
      "name": "sigma-4",
      "params": {
        "sigma": 10,
        "amount": 1
      },
      "expected_args": [
        "-unsharp",
        "0x10+1"
      ]
    },
    {
      "name": "amount-0",
      "params": {
        "sigma": 1,
        "amount": 0
      },
      "expected_args": [
        "-unsharp",
        "0x1+0"
      ]
    },
    {
      "name": "amount-1",
      "params": {
        "sigma": 1,
        "amount": -1
      },
      "expected_args": [
        "-unsharp",
        "0x1+-1"
      ]
    },
    {
      "name": "amount-2",
      "params": {
        "sigma": 1,
        "amount": 0.5
      },
      "expected_args": [
        "-unsharp",
        "0x1+0.5"
      ]
    },
    {
      "name": "amount-3",
      "params": {
        "sigma": 1,
        "amount": 0
      },
      "expected_args": [
        "-unsharp",
        "0x1+0"
      ]
    },
    {
      "name": "amount-4",
      "params": {
        "sigma": 1,
        "amount": 5
      },
      "expected_args": [
        "-unsharp",
        "0x1+5"
      ]
    }
  ]
}
