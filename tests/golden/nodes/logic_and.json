        "b": null,
        "result": false
      }
    },
    {
      "name": "missing",
      "params": {},
      "expected_params": {
        "result": false
      }
    },
    {
      "name": "broadcast-2",
      "params": {
        "a": [
          1,
          2,
          3
        ],
        "b": [
          4
        ],
        "result": false
      },
      "expected_params": {
        "a": [
          1,
          2,
          3
        ],
        "b": [
          4
        ],
        "result": true
      }
    },
    {
      "name": "broadcast-3",
      "params": {
        "a": 2,
        "b": [
          3,
          4
        ],
        "result": false
      },
      "expected_params": {
        "a": 2,
        "b": [
          3,
          4
        ],
        "result": true
      }
    },
    {
      "name": "broadcast-4",
      "params": {
        "a": [
          1,
          0
        ],
        "b": 0,
        "result": false
      },
      "expected_params": {
        "a": [
          1,
          0
        ],
        "b": 0,
        "result": false
      }
    }
