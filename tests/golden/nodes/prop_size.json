{
  "definition": {
    "id": "prop_size",
    "version": "1.0.0",
    "label": "Size",
    "description": "Outputs the file size of the current image in the selected unit",
    "category": "Properties",
    "inputs": [],
    "outputs": [],
    "executor": "prop_size",
    "needs_image_meta": true,
    "params": [
      {
        "name": "unit",
        "label": "Unit",
        "type": "enum",
        "widget": "dropdown",
        "default": "bytes",
        "options": [
          "bytes",
          "KB",
          "MB",
          "GB"
        ]
      },
      {
        "name": "value",
        "label": "Size",
        "type": "float",
        "widget": "number",
        "default": 0,
        "readonly": true
      }
    ]
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "unit": "bytes",
        "value": 0
      },
      "meta": {
        "path": "/fixtures/photo.test.png",
        "name": "photo.test.png",
        "sizeBytes": 4096,
        "width": 128,
        "height": 75,
        "bitDepth": 16,
        "extension": "png",
        "dpiX": 300,
        "dpiY": 72,
        "exif": {
          "Make": "TestCam",
          "FNumber": "28/10",
          "FocalLength": "50/1",
          "ISOSpeedRatings": "200,0",
          "DateTimeOriginal": "2020:01:02 03:04:05"
        }
      },
      "expected_params": {
        "unit": "bytes",
        "value": 4096
      }
    },
    {
      "name": "defaults-no-meta",
      "params": {
        "unit": "bytes",
        "value": 0
      },
      "expected_params": {
        "unit": "bytes",
        "value": 0
      }
