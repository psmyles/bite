      },
      {
        "name": "xy",
        "label": "XY",
        "type": "vector2",
        "readonly": true,
        "portOnly": true
      },
      {
        "name": "x",
        "label": "X",
        "type": "float",
        "readonly": true,
        "portOnly": true
      },
      {
        "name": "y",
        "label": "Y",
        "type": "float",
        "readonly": true,
        "portOnly": true
      }
    ]
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "vec": [
          0,
          0
        ]
      },
      "expected_params": {
        "vec": [
          0,
          0
        ],
        "xy": [
          0,
          0
        ],
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "missing",
      "params": {},
      "expected_params": {
        "xy": [
          0,
          0
        ],
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "vec-0",
      "params": {
        "vec": [
          0,
          0
        ]
      },
      "expected_params": {
        "vec": [
          0,
          0
        ],
        "xy": [
          0,
          0
        ],
        "x": 0,
        "y": 0
      }
    },
    {
      "name": "vec-1",
      "params": {
        "vec": [
          3,
          0,
          4
        ]
      },
      "expected_params": {
        "vec": [
          3,
          0,
          4
        ],
        "xy": [
          3,
          0
        ],
        "x": 3,
        "y": 0
      }
    }
  ]
}
