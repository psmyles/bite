{
  "definition": {
    "id": "prop_resolution",
    "version": "1.0.0",
    "label": "Resolution",
    "description": "Outputs the horizontal and vertical DPI of the current image",
    "category": "Properties",
    "inputs": [],
    "outputs": [],
    "executor": "prop_resolution",
    "needs_image_meta": true,
    "params": [
      {
        "name": "dpi_x",
        "label": "DPI X",
        "type": "float",
        "widget": "number",
        "default": 0,
        "readonly": true
      },
      {
        "name": "dpi_y",
        "label": "DPI Y",
        "type": "float",
        "widget": "number",
        "default": 0,
        "readonly": true
      }
    ]
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "dpi_x": 0,
        "dpi_y": 0
      },
      "meta": {
        "path": "/fixtures/photo.test.png",
        "name": "photo.test.png",
        "sizeBytes": 4096,
        "width": 128,
        "height": 75,
        "bitDepth": 16,
        "extension": "png",
        "dpiX": 300,
        "dpiY": 72,
        "exif": {
          "Make": "TestCam",
          "FNumber": "28/10",
          "FocalLength": "50/1",
          "ISOSpeedRatings": "200,0",
          "DateTimeOriginal": "2020:01:02 03:04:05"
        }
      },
      "expected_params": {
        "dpi_x": 300,
        "dpi_y": 72
      }
    },
    {
      "name": "defaults-no-meta",
      "params": {
        "dpi_x": 0,
        "dpi_y": 0
      },
      "expected_params": {
        "dpi_x": 0,
        "dpi_y": 0
      }
    },
    {
      "name": "missing",
      "params": {},
      "meta": {
        "path": "/fixtures/photo.test.png",
        "name": "photo.test.png",
        "sizeBytes": 4096,
        "width": 128,
        "height": 75,
        "bitDepth": 16,
        "extension": "png",
        "dpiX": 300,
        "dpiY": 72,
        "exif": {
          "Make": "TestCam",
          "FNumber": "28/10",
          "FocalLength": "50/1",
          "ISOSpeedRatings": "200,0",
          "DateTimeOriginal": "2020:01:02 03:04:05"
        }
      },
      "expected_params": {
        "dpi_x": 300,
        "dpi_y": 72
      }
    },
    {
      "name": "missing-no-meta",
      "params": {},
      "expected_params": {
        "dpi_x": 0,
        "dpi_y": 0
      }
    }
  ]
}
