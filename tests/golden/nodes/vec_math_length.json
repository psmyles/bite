{
  "definition": {
    "id": "vec_math_length",
    "version": "1.0.0",
    "label": "Length",
    "description": "Magnitude of vector (|V|)",
    "category": "Math",
    "inputs": [],
    "outputs": [],
    "executor": "vec_math_length",
    "params": [
      {
        "name": "vec",
        "label": "Vector",
        "type": "numeric",
        "widget": "number",
        "default": 0
      },
      {
        "name": "result",
        "label": "Result",
        "type": "float",
        "widget": "number",
        "default": 0,
        "readonly": true
      }
    ]
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "vec": 0,
        "result": 0
      },
      "expected_params": {
        "vec": 0,
        "result": 0
      }
    },
    {
      "name": "missing",
      "params": {},
      "expected_params": {
        "result": 0
      }
    },
    {
      "name": "vec-0",
      "params": {
        "vec": 0,
        "result": 0
      },
      "expected_params": {
        "vec": 0,
        "result": 0
      }
    },
    {
      "name": "vec-1",
      "params": {
        "vec": -1,
        "result": 0
      },
      "expected_params": {
        "vec": -1,
        "result": 1
      }
    },
    {
      "name": "vec-2",
      "params": {
        "vec": 0.5,
        "result": 0
      },
      "expected_params": {
        "vec": 0.5,
        "result": 0.5
      }
    },
    {
      "name": "vec-3",
      "params": {
        "vec": [
          0,
          0
        ],
        "result": 0
      },
      "expected_params": {
        "vec": [
          0,
          0
        ],
        "result": 0
      }
    },
    {
      "name": "vec-4",
      "params": {
        "vec": [
          3,
          0,
          4
        ],
        "result": 0
      },
      "expected_params": {
        "vec": [
          3,
          0,
          4
        ],
        "result": 5
      }
    },
    {
      "name": "vec-5",
      "params": {
        "vec": [
          2
        ],
        "result": 0
      },
      "expected_params": {
        "vec": [
          2
        ],
        "result": 2
      }
    }
  ]
}
