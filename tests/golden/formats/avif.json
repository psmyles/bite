{
  "definition": {
    "id": "AVIF",
    "extension": ".avif",
    "params": [
      {
        "name": "avif_quality",
        "label": "Quality",
        "type": "int",
        "widget": "slider",
        "min": 1,
        "max": 100,
        "default": 60
      },
      {
        "name": "avif_speed",
        "label": "Encode Speed (0 = slow/best, 8 = fast)",
        "type": "int",
        "widget": "slider",
        "min": 0,
        "max": 8,
        "default": 4
      }
    ],
    "args_js": "return ['-quality',String(params.avif_quality??60),'-define','avif:speed='+String(params.avif_speed??4)];"
  },
  "cases": [
    {
      "name": "defaults",
      "params": {
        "avif_quality": 60,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "missing",
      "params": {},
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_quality-0",
      "params": {
        "avif_quality": 0,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "0",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_quality-1",
      "params": {
        "avif_quality": -1,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "-1",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_quality-2",
      "params": {
        "avif_quality": 0.5,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "0.5",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_quality-3",
      "params": {
        "avif_quality": 1,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "1",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_quality-4",
      "params": {
        "avif_quality": 100,
        "avif_speed": 4
      },
      "expected_args": [
        "-quality",
        "100",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_speed-0",
      "params": {
        "avif_quality": 60,
        "avif_speed": 0
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=0"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_speed-1",
      "params": {
        "avif_quality": 60,
        "avif_speed": -1
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=-1"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_speed-2",
      "params": {
        "avif_quality": 60,
        "avif_speed": 0.5
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=0.5"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_speed-3",
      "params": {
        "avif_quality": 60,
        "avif_speed": 0
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=0"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "avif_speed-4",
      "params": {
        "avif_quality": 60,
        "avif_speed": 8
      },
      "expected_args": [
        "-quality",
        "60",
        "-define",
        "avif:speed=8"
      ],
      "expected_extension": ".avif"
    },
    {
      "name": "legacy-quality",
      "params": {
        "quality": 42
      },
      "expected_args": [
        "-quality",
        "42",
        "-define",
        "avif:speed=4"
      ],
      "expected_extension": ".avif"
    }
  ]
}
