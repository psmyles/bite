{
  "name": "bite",
  "productName": "Bite",
  "author": "psmyles",
  "description": "Bite (Batch Image Transformation Editor) - a GUI batch image workflow builder powered by ImageMagick",
  "license": "MIT",
  "private": true,
  "version": "0.5.0",
  "type": "commonjs",
  "bin": {
    "bite": "./dist-electron/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run format && tsc && vite build && vite build --config vite.cli.config.mts && pkg dist-cli/cli-bundle.js --target node20-win-x64 --output dist-cli/cli-bundle.exe && electron-builder --win",
    "build:mac": "scripts/build-mac.sh",
    "bundle:magick:mac": "scripts/bundle-magick-mac.sh",
    "build:icon:mac": "scripts/build-icon-mac.sh",
    "build:web": "npm run format && vite build --config vite.web.config.mts",
    "preview": "vite preview",
    "link:cli": "npm link",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:golden": "vitest run src/tests/migration-golden.test.ts",
    "test:workflows": "vite build --config vite.cli.config.mts && node test-workflows/run-tests.mjs",
    "test:compat": "vite build --config vite.cli.config.mts && cargo build -p bite-cli && node test-workflows/compat-edgecases.mjs",
    "bench:rust-migration": "vite build --config vite.cli.config.mts && vite build --config test-workflows/vite.benchmark.config.mts && cargo build --release -p bite-cli && node test-workflows/benchmark-performance.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/patch-nsis.cjs",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-arm64"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@yao-pkg/pkg": "^6.14.1",
    "electron": "^42.1.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.0"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@xyflow/svelte": "^1.5.1",
    "marked": "^18.0.4",
    "svelte": "^5.53.7"
  }
}
