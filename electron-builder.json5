// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.bite.app',
  asar: true,
  productName: 'Bite',
  directories: {
    output: 'release/${version}',
    buildResources: 'build',
  },
  // Vite copies public/ into dist/ wholesale, which drags the Icon Composer
  // source in with it. It is only a build input - the packaged app gets the
  // compiled icon instead - so keep ~1 MB of layer art out of the asar.
  files: ['dist', 'dist-electron', '!dist/bite.icon'],
  fileAssociations: [
    {
      ext: 'bite',
      name: 'Bite Workflow',
      description: 'Bite workflow file',
      role: 'Editor',
    },
  ],
  win: {
    executableName: 'bite-gui',
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    extraResources: [
      {
        // Bundled ImageMagick - placed at resources/magick/ inside the packaged app.
        // At runtime getMagickBinary() resolves this via process.resourcesPath.
        from: 'resources/win/magick',
        to: 'magick',
        filter: ['**/*'],
      },
    ],
    extraFiles: [
      {
        // Standalone CLI exe placed at the install root so $INSTDIR\bite.exe
        // is on PATH after the installer runs.
        from: 'dist-cli/cli-bundle.exe',
        to: 'bite.exe',
      },
      {
        // Node definitions shipped as plain JSON files so users can add custom nodes.
        from: 'node-definitions',
        to: 'node-definitions',
        filter: ['**/*.json'],
      },
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    include: 'build/installer.nsh',
  },
  mac: {
    // The app is Bite.app; 'bite-gui' would leak the Windows executable name
    // into the Finder.
    executableName: 'Bite',
    // arm64 only: the bundled ImageMagick is relocated from an Apple Silicon
    // Homebrew install (scripts/bundle-magick-mac.sh). Intel Macs fall back to
    // a `magick` on PATH.
    target: [
      {
        target: 'dmg',
        arch: ['arm64'],
      },
    ],
    artifactName: '${productName}-Mac-${version}-arm64.${ext}',
    category: 'public.app-category.graphics-design',
    // Both built from public/bite.icon by scripts/build-icon-mac.sh.
    // icon.icns is the flattened fallback that electron-builder copies to
    // Contents/Resources/icon.icns and points CFBundleIconFile at; macOS 26+
    // ignores it in favour of the Assets.car below.
    icon: 'build/icons/mac/icon.icns',
    extendInfo: {
      // Names the icon inside Assets.car. Without it the catalogue is dead
      // weight and macOS falls back to the flattened icns, losing the layered
      // Liquid Glass rendering (tinted, dark and clear appearances included).
      CFBundleIconName: 'bite',
    },
    hardenedRuntime: true,
    // Credentials come from APPLE_ID / APPLE_APP_SPECIFIC_PASSWORD / APPLE_TEAM_ID.
    notarize: true,
    gatekeeperAssess: false,
    entitlements: 'build/entitlements.mac.plist',
    entitlementsInherit: 'build/entitlements.mac.plist',
    // bundle-magick-mac.sh already signs all ~148 Mach-O files under magick/
    // with this same identity, the hardened runtime and secure timestamps - it
    // has to, because install_name_tool invalidates their signatures. Letting
    // electron-builder re-sign them duplicates that work and, more to the
    // point, fires ~148 extra requests at timestamp.apple.com, which throttles
    // and fails the build with "A timestamp was expected but was not found".
    signIgnore: ['Contents/Resources/magick/'],
    extraResources: [
      {
        // Compiled icon catalogue. It has to sit at Contents/Resources/
        // Assets.car - that is the only place the icon services look for it.
        from: 'build/icons/mac/Assets.car',
        to: 'Assets.car',
      },
      {
        // Bundled ImageMagick (binary + dylibs + coder modules + config).
        // Resolved at runtime through process.resourcesPath, same as Windows.
        from: 'resources/mac/magick',
        to: 'magick',
        filter: ['**/*'],
      },
      {
        // A .app has no install root to drop files into, so the CLI and the
        // node definitions live in Contents/Resources. Keeping them in the same
        // directory means the CLI finds both node-definitions/ and magick/
        // relative to its own path.
        from: 'dist-cli/cli-bundle-macos',
        to: 'bite',
      },
      {
        from: 'node-definitions',
        to: 'node-definitions',
        filter: ['**/*.json'],
      },
    ],
  },
  dmg: {
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    title: '${productName} ${version}',
    contents: [
      { x: 140, y: 200, type: 'file' },
      { x: 400, y: 200, type: 'link', path: '/Applications' },
    ],
  },
  linux: {
    executableName: 'bite-gui',
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
