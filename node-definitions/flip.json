  },
  "inputs": [
    {
      "label": "Input",
      "name": "input",
      "type": "image"
    }
  ],
  "label": "Flip",
  "outputs": [
    {
      "label": "Output",
      "name": "output",
      "type": "image"
    }
  ],
  "params": [
    {
      "default": "horizontal",
      "label": "Axis",
      "name": "axis",
      "options": [
        "horizontal",
        "vertical"
      ],
      "type": "enum",
      "widget": "dropdown"
    }
  ],
  "schema_version": 2,
  "version": "1.0.0"
}
