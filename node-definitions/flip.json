{
  "id": "flip",
  "version": "1.0.0",
  "label": "Flip",
  "description": "Mirror the image horizontally or vertically",
  "aliases": ["mirror", "reflect", "horizontal flip", "vertical flip"],
  "category": "Transform",
  "icon": "flip-horizontal",
  "inputs": [
    {
      "type": "image",
      "label": "Input"
    }
  ],
  "outputs": [
    {
      "type": "image",
      "label": "Output"
    }
  ],
  "params": [
    {
      "name": "axis",
      "label": "Axis",
      "type": "enum",
      "widget": "dropdown",
      "default": "horizontal",
      "options": ["horizontal", "vertical"]
    }
  ],
  "command_js": "return [params.axis === 'vertical' ? '-flip' : '-flop'];"
}
