      "widget": "text"
    },
    {
      "default": false,
      "label": "Folder Only",
      "name": "strip_filename",
      "noPort": true,
      "type": "bool",
      "widget": "checkbox"
    }
  ],
  "schema_version": 2,
  "version": "1.0.0"
}
