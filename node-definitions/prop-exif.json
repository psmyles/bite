{
  "category": "Properties",
  "description": "Outputs EXIF metadata from the current image",
  "id": "prop_exif",
  "implementation": {
    "outputs": {
      "aperture": "if(bool(rational(image.exif.FNumber)), rational(image.exif.FNumber), rational(image.exif.ApertureValue))",
      "camera_make": "image.exif.Make",
      "camera_model": "image.exif.Model",
      "date_taken": "image.exif.DateTimeOriginal",
      "exposure_time": "image.exif.ExposureTime",
      "focal_length": "rational(image.exif.FocalLength)",
      "iso": "if(bool(parse_int(image.exif.PhotographicSensitivity)), parse_int(image.exif.PhotographicSensitivity), parse_int(image.exif.ISOSpeedRatings))",
      "lens": "if(bool(image.exif.LensModel), image.exif.LensModel, image.exif.LensMake)",
      "shutter_speed": "image.exif.ShutterSpeedValue"
    },
    "type": "compute"
  },
  "inputs": [],
  "label": "EXIF",
  "outputs": [],
  "params": [
    {
      "default": "",
      "label": "Camera Make",
      "name": "camera_make",
      "readonly": true,
      "type": "string",
      "widget": "text"
    },
    {
      "default": "",
      "label": "Camera Model",
      "name": "camera_model",
