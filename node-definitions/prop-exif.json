    },
    {
      "default": "",
      "label": "Shutter Speed",
      "name": "shutter_speed",
      "readonly": true,
      "type": "string",
      "widget": "text"
    },
    {
      "default": 0,
      "label": "Aperture",
      "name": "aperture",
