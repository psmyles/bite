{
  "id": "hue_offset",
  "version": "1.0.0",
  "label": "Hue Offset",
  "description": "Shift the hue of an image",
  "aliases": ["hue shift", "hue rotate", "color shift"],
  "category": "Color",
  "icon": "palette",
  "inputs": [
    {
      "type": "image",
      "label": "Input"
    }
  ],
  "outputs": [
    {
      "type": "image",
      "label": "Output"
    }
  ],
  "params": [
    {
      "name": "hue",
      "label": "Hue Shift",
      "type": "int",
      "widget": "slider",
      "default": 0,
      "min": -180,
      "max": 180
    }
  ],
  "command_js": "const hue = Number(params.hue) || 0; return ['-modulate', `100,100,${100 + hue / 1.8}`];"
}
