        "expr": "dither"
      },
      "-colors",
      {
        "expr": "colors"
      }
    ],
    "type": "imagemagick"
  },
  "inputs": [
    {
      "label": "Input",
      "name": "input",
      "type": "image"
    }
  ],
  "label": "Quantize",
